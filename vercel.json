{
  "version": 2,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.miraista.com"
        }
      ],
      "destination": "https://miraista.com/$1",
      "permanent": true
    },
    {
      "source": "/claim-upload",
      "destination": "/claimupload",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/consulting",
      "destination": "/consulting.html"
    },
    {
      "source": "/consulting/",
      "destination": "/consulting.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
